services:
  - type: web
    name: matching-app-web
    runtime: ruby
    plan: free
    autoDeploy: true
    region: oregon            # ←Postgresと同じリージョンに合わせてください
    buildCommand: "./bin/render-build.sh"
    startCommand: "bin/rails db:migrate && bin/rails server -b 0.0.0.0 -p $PORT"
    envVars:
      - key: DATABASE_URL
        fromDatabase:
          name: matching-app-db
          property: connectionString
      - key: RAILS_MASTER_KEY
        sync: false              # 最初のデプロイ後にDashboardで入力
      - key: WEB_CONCURRENCY
        value: "2"               # メモリ節約のため控えめに

databases:
  - name: matching-app-db
    plan: free
    region: oregon            # ←webと同じ
